{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "build" }
    }
  ],
  "routes": [
    
    { "src": "/api/(.*)", "dest": "https://pcp-szng.vercel.app/api" },
    
    
    { "handle": "filesystem" },
    
    
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
